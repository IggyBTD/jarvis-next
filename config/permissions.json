{
  "_readme": "User permission rules, checked before an action runs. Order: blocked commands (blocked-commands.json) never run; then deny wins over ask, ask wins over allow, allow wins over the action's default tier in actions.json. A blocked action can never be allowed. A rule is an action name, or name(pattern) where pattern is matched against the action's primary argument with * as a wildcard. Shell commands are split at ; | || && and every part must match an allow rule; a command with a subshell, backticks, redirection or & is never allowed by a rule and always asks. This file is the shipped starting set. Rules added with 'Always allow' go to data/agent/permissions.local.json (git-ignored) and are merged in; you can also append to the allow list below by hand.",
  "_examples": [
    "switch_model(coding)",
    "run_command(npm test*)",
    "run_command(cargo test*)",
    "edit_file(src/**)",
    "write_file(docs/*)",
    "browser_goto(*)",
    "browser_goto(*paypal*)"
  ],
  "allow": [
    "run_command(git status*)",
    "run_command(git diff*)",
    "run_command(git log*)",
    "run_command(git show*)",
    "run_command(git branch)",
    "run_command(git branch -a)",
    "run_command(git branch -v)",
    "run_command(git branch --list*)",
    "run_command(git rev-parse*)",
    "run_command(git remote -v)",
    "run_command(pwd)",
    "run_command(ls)",
    "run_command(ls -*)",
    "run_command(ls *)",
    "run_command(dir)",
    "run_command(dir *)",
    "run_command(echo *)",
    "run_command(cat *)",
    "run_command(head *)",
    "run_command(tail *)",
    "run_command(wc *)",
    "run_command(grep *)",
    "run_command(findstr *)",
    "run_command(Get-ChildItem*)",
    "run_command(Get-Content*)",
    "run_command(Select-String*)",
    "run_command(Get-Location)",
    "run_command(node --version)",
    "run_command(npm --version)",
    "run_command(cargo --version)",
    "browser_goto(*)",
    "browser_click(*)"
  ],
  "ask": [
    "read_file(*.env*)",
    "read_file(*id_rsa*)",
    "read_file(*id_ed25519*)",
    "read_file(*.pem)",
    "read_file(*.key)",
    "write_file(*.env*)",
    "edit_file(*.env*)",
    "write_file(.github/*)",
    "edit_file(.github/*)",
    "run_command(*.env*)",
    "run_command(*id_rsa*)",
    "run_command(*id_ed25519*)",
    "run_command(*.pem*)",
    "browser_goto(*paypal*)",
    "browser_goto(*stripe*)",
    "browser_goto(*bank*)",
    "browser_goto(*checkout*)",
    "browser_goto(*wallet*)",
    "browser_goto(*coinbase*)",
    "browser_goto(*binance*)",
    "browser_goto(*revolut*)",
    "browser_goto(*mail.google*)",
    "browser_goto(*outlook*)",
    "browser_goto(*accounts.google*)",
    "browser_goto(*login.microsoftonline*)",
    "browser_goto(*appleid*)"
  ],
  "deny": []
}
